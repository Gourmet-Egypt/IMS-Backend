{
	"info": {
		"name": "Change Password",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Change Password",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"old_password\": \"current_password\",\n    \"password\": \"new_password\",\n    \"password_confirmation\": \"new_password\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/change-password",
					"host": ["{{base_url}}"],
					"path": ["api", "change-password"]
				}
			},
			"response": [
				{
					"name": "Success",
					"status": "OK",
					"code": 200,
					"body": "{\n    \"status\": 200,\n    \"message\": \"Password changed successfully.\",\n    \"data\": {\n        \"id\": 1,\n        \"name\": \"John Doe\",\n        \"email\": \"john@example.com\",\n        \"user_number\": \"12345\",\n        \"store_id\": 1,\n        \"role\": \"user\",\n        \"security_level\": 2,\n        \"email_verified_at\": null,\n        \"created_at\": \"2024-01-01T00:00:00.000000Z\",\n        \"updated_at\": \"2024-01-01T00:00:00.000000Z\"\n    }\n}"
				},
				{
					"name": "Old Password Incorrect",
					"status": "Unprocessable Entity",
					"code": 422,
					"body": "{\n    \"status\": 422,\n    \"message\": \"The provided old password is incorrect.\",\n    \"data\": null\n}"
				},
				{
					"name": "Password Confirmation Mismatch",
					"status": "Unprocessable Entity",
					"code": 422,
					"body": "{\n    \"status\": 422,\n    \"message\": \"Password confirmation does not match.\",\n    \"data\": null\n}"
				},
				{
					"name": "Password Too Short",
					"status": "Unprocessable Entity",
					"code": 422,
					"body": "{\n    \"status\": 422,\n    \"message\": \"New password must be at least 6 characters.\",\n    \"data\": null\n}"
				}
			]
		}
	]
}
